    <item>
      <title>BUUCTF 神秘龙卷风 1</title>
      <link>https://yuexuan521.github.io/zh/posts/buuctf-%E7%A5%9E%E7%A7%98%E9%BE%99%E5%8D%B7%E9%A3%8E-1/</link>
