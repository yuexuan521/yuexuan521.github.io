</span><span class="lnt">26
</span><span class="lnt">27
</span></code></pre></td>
<td class="lntd">
<pre tabindex="0" class="chroma"><code class="language-python" data-lang="python"><span class="line"><span class="cl"><span class="mi">8</span> <span class="n">位数字破解</span>
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl"><span class="n">Hashcat64</span> <span class="o">-</span><span class="n">m</span> <span class="mi">9700</span> <span class="nb">hash</span> <span class="o">-</span><span class="n">a</span> <span class="mi">3</span> <span class="err">?</span><span class="n">d</span><span class="err">?</span><span class="n">d</span><span class="err">?</span><span class="n">d</span><span class="err">?</span><span class="n">d</span><span class="err">?</span><span class="n">d</span><span class="err">?</span><span class="n">d</span><span class="err">?</span><span class="n">d</span><span class="err">?</span><span class="n">d</span> <span class="o">-</span><span class="n">w</span> <span class="mi">3</span> <span class="err">–</span><span class="n">O</span>
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl"><span class="mi">1</span><span class="o">-</span><span class="mi">8</span> <span class="n">位数字破解</span>
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl"><span class="n">Hashcat</span> <span class="o">-</span><span class="n">m</span> <span class="mi">9700</span> <span class="nb">hash</span> <span class="o">-</span><span class="n">a</span> <span class="mi">3</span> <span class="o">--</span><span class="n">increment</span> <span class="o">--</span><span class="n">increment</span><span class="o">-</span><span class="nb">min</span> <span class="mi">1</span><span class="err">–</span><span class="n">increment</span><span class="o">-</span><span class="nb">max</span> <span class="mi">8</span> <span class="err">?</span><span class="n">d</span><span class="err">?</span><span class="n">d</span><span class="err">?</span><span class="n">d</span><span class="err">?</span><span class="n">d</span><span class="err">?</span><span class="n">d</span><span class="err">?</span><span class="n">d</span><span class="err">?</span><span class="n">d</span><span class="err">?</span><span class="n">d</span>
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl"><span class="mi">1</span> <span class="n">到</span> <span class="mi">8</span> <span class="n">位小写字母破解</span>
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl"><span class="n">Hashcat</span> <span class="o">-</span><span class="n">m</span> <span class="mi">9700</span> <span class="nb">hash</span> <span class="o">-</span><span class="n">a</span> <span class="mi">3</span> <span class="o">--</span><span class="n">increment</span> <span class="o">--</span><span class="n">increment</span><span class="o">-</span><span class="nb">min</span> <span class="mi">1</span><span class="err">–</span><span class="n">increment</span><span class="o">-</span><span class="nb">max</span> <span class="mi">8</span> <span class="err">?</span><span class="n">l</span><span class="err">?</span><span class="n">l</span><span class="err">?</span><span class="n">l</span><span class="err">?</span><span class="n">l</span><span class="err">?</span><span class="n">l</span><span class="err">?</span><span class="n">l</span><span class="err">?</span><span class="n">l</span><span class="err">?</span><span class="n">l</span>
