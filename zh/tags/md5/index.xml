<pre tabindex="0" class="chroma"><code class="language-java" data-lang="java"><span class="line"><span class="cl"><span class="n">明文</span><span class="err">：</span><span class="n">hello</span><span class="err">，</span><span class="n">world</span><span class="p">.</span><span class="na">123456</span><span class="w">
</span></span></span><span class="line"><span class="cl"><span class="nf">md5</span><span class="p">(</span><span class="n">hello</span><span class="err">，</span><span class="n">world</span><span class="p">.</span><span class="na">123456</span><span class="p">,</span><span class="n">32</span><span class="p">)</span><span class="w"> </span><span class="o">=</span><span class="w"> </span><span class="n">5189503aae1b1c0a6fbf7ea9e3128ab0</span><span class="w">
</span></span></span><span class="line"><span class="cl"><span class="nf">md5</span><span class="p">(</span><span class="n">hello</span><span class="err">，</span><span class="n">world</span><span class="p">.</span><span class="na">123456</span><span class="p">,</span><span class="n">16</span><span class="p">)</span><span class="w"> </span><span class="o">=</span><span class="w"> </span><span class="n">ae1b1c0a6fbf7ea9</span><span class="w">
</span></span></span></code></pre></td></tr></table>
</div>
